# SPDX-License-Identifier: MPL-2.0
# Builds mothrix from this checkout: run `makepkg -si` in this folder.
pkgname=mothrix
pkgver=0.3.1
pkgrel=1
pkgdesc="A terminal Matrix client with a room sidebar and mouse support"
url="https://github.com/r1sq/mothrix"
arch=('x86_64' 'aarch64')
license=('MPL-2.0')
depends=('gcc-libs')
makedepends=('cargo' 'cmake' 'clang')
optdepends=('xdg-utils: open attachments and links'
            'libnotify: desktop notifications'
            'wl-clipboard: clipboard on Wayland'
            'xclip: clipboard on X11'
            'hunspell-en_us: spell checking'
            'mpv: play voice messages and audio')
source=()

_repo() { cd "$startdir/../.." && pwd; }

build() {
  cd "$(_repo)"
  export CARGO_TARGET_DIR="$srcdir/target"
  # Updating is the package manager's: mothrix only says when one is out.
  MOTHRIX_PACKAGED=1 cargo build --release --locked
}

check() {
  cd "$(_repo)"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked
}

package() {
  cd "$(_repo)"
  install -Dm755 "$srcdir/target/release/mothrix" "$pkgdir/usr/bin/mothrix"
  install -Dm644 docs/mothrix.1 "$pkgdir/usr/share/man/man1/mothrix.1"
  install -Dm644 packaging/mothrix.desktop "$pkgdir/usr/share/applications/mothrix.desktop"
  install -Dm644 assets/mothrix-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/mothrix.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/mothrix/README.md"
  for doc in features usage configuration install updates; do
    install -Dm644 "docs/$doc.md" "$pkgdir/usr/share/doc/mothrix/$doc.md"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/mothrix/LICENSE"
}
