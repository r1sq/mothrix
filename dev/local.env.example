# Copy to dev/local.env (not in git) and fill in: the Mac that builds the
# iOS app for dev/mac.sh, dev/sim.sh and dev/sim-shot.sh.
MOTHRIX_MAC=builder@mac.example
# MOTHRIX_MAC_SSH="-i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes"
# MOTHRIX_MAC_SETUP='export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer;'
# The simulator to use: `dev/mac.sh xcrun simctl list devices`.
MOTHRIX_SIM=${MOTHRIX_SIM:-00000000-0000-0000-0000-000000000000}   # a variable set for one call wins
# MOTHRIX_SIM_CONFIG=Release        # no debug line in the conversation
# MOTHRIX_BUNDLE_ID=de.tmrk.mothrix # if the app is built under another id
